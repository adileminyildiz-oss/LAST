# ---- Configuration du serveur portail client Mar'q ----
# Copiez ce fichier en « .env » puis renseignez les valeurs.
# NE COMMITEZ JAMAIS votre .env réel (secrets).

# Port d'écoute HTTP du serveur.
PORT=8787

# Secret partagé du cabinet : requis pour appeler /admin/sync et /admin/file.
# Générez une valeur forte, ex. :  openssl rand -hex 32
CABINET_TOKEN=changez-moi-secret-cabinet

# Secret de signature des jetons de session client (HMAC-SHA256).
# Générez une valeur forte, ex. :  openssl rand -hex 32
JWT_SECRET=changez-moi-secret-jwt

# Origine(s) du site autorisée(s) pour le CORS (séparées par des virgules).
# En production, mettez l'URL exacte du site :
ALLOWED_ORIGIN=https://last.aemconseil.eu
# En développement local, vous pouvez autoriser l'origine locale ou toutes :
# ALLOWED_ORIGIN=http://localhost:8080,http://localhost:8787
# ALLOWED_ORIGIN=*

# Dossier de stockage sur disque (JSON + fichiers). Chemin absolu recommandé
# en production (volume persistant). Par défaut : ./data
DATA_DIR=./data

# Durée de validité d'une session client, en secondes (défaut 7200 = 2 h).
SESSION_TTL=7200

# Anti brute-force : nb max de tentatives de login par IP+client sur la fenêtre.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MS=600000
